{
  "name": "video-editor-app",
  "version": "1.17.2",
  "description": "Desktop multi-clip video editor for combining and exporting videos as one file.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "pack:win": "electron-builder --win zip"
  },
  "keywords": [
    "electron",
    "video-editor",
    "ffmpeg"
  ],
  "author": "OpenAI Codex",
  "license": "GPL-3.0-or-later",
  "build": {
    "appId": "com.openai.cutlinestudio",
    "productName": "Cutline Studio",
    "afterAllArtifactBuild": "./scripts/cleanup-win-unpacked.js",
    "asar": false,
    "compression": "store",
    "directories": {
      "output": "dist/${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "package.json",
      "subtitle-engine/**/*",
      "!subtitle-engine/.venv/**",
      "!subtitle-engine/vendor/downloads/**",
      "!subtitle-engine/**/__pycache__/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-x64.${ext}"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  }
}
